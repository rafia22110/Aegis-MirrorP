# AEGIS MIRRORP — environment for the Vercel deployment
# Copy to .env.local for local dev, set the same keys in Vercel for prod.

# The private engine's API origin. When unset, the public mirror uses
# its own built-in fallback responses (no real DNS, no live journal).
# Example: https://api.aegis-mirror.example
AEGIS_ENGINE_URL=
