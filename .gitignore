# Aegis MirrorP — Public Mirror .gitignore
# This file is for the PUBLIC mirror repository. The private engine repository
# keeps .db, .sqlite, .env, and VPS configs locally; those are excluded here.

# --- Node / Vercel / Frontend ---
node_modules/
.vercel/
.next/
out/
dist/
build/

# --- Local environment files (NEVER commit secrets) ---
.env
.env.local
.env.*.local
.env.production

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
bun-debug.log*

# --- Editor / OS noise ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# --- PocketBase runtime artifacts (the engine; public mirror strips these) ---
pb_data/
pb_data.db
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# --- VPS / Infrastructure (private repo only) ---
vps/docker-compose.yml
vps/Caddyfile
vps/.env
vps/pb_data/
vps/pb_hooks/
vps/pb_public/
docker-compose.yml
Dockerfile
Caddyfile

# --- Build / cache ---
.cache/
.turbo/
.parcel-cache/
coverage/

# --- Misc ---
*.pid
*.seed
*.pid.lock
.tmp/