{
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index"
    },
    {
      "source": "/api/aegis/check-policy",
      "destination": "/api/check-policy"
    },
    {
      "source": "/api/journal",
      "destination": "/api/journal"
    },
    {
      "source": "/api/register-test",
      "destination": "/api/register-test"
    },
    {
      "source": "/api/install-state",
      "destination": "/api/install-state"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        }
      ]
    }
  ]
}